# Secrets
*.env
.env
kaggle-rag-chatbot.env
.streamlit/secrets.toml

# Python
__pycache__/
*.pyc
.venv/
venv/

# Raw data -- NOT shipped
data/raw/

# chroma_db IS shipped: the prebuilt index for the full catalogue, so the deployed
# app starts without embedding anything. The app verifies it against
# products_clean.csv at startup (hash + row count) and rebuilds it if they differ.

# Ship only products_clean.csv; keep other processed files local-only
data/processed/*
!data/processed/products_clean.csv

# Evaluation outputs and caches
eval/results_*.json
.pytest_cache/

# OS
.DS_Store
