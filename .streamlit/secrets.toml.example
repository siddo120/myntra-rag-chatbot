# Streamlit Cloud secrets template.
# On share.streamlit.io, open your app -> Settings -> Secrets and paste ONE of:
#
#   GROQ_API_KEY = "gsk_..."      # default: Groq, model openai/gpt-oss-120b
#   OPENAI_API_KEY = "sk-..."     # alternative: OpenAI, model gpt-4o-mini
#
# Embeddings run locally, so no embedding key is needed.
# Do NOT commit the real secrets.toml (it is git-ignored).
GROQ_API_KEY = "gsk_REPLACE_ME"
